# Healthcare Information Management System - Git Ignore Rules
# Strictly prevents committing secrets, credentials, backups, dumps, or logs

# Credentials, Keys, and Secrets
*.pem
*.ppk
*.key
*.p12
*.pfx
*.pkcs12
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
*.pub
.env*
!.env.example
*token*
*secret*
*password*
# The three broad patterns above are meant to catch credential-shaped files (dumped tokens,
# secret configs), but they also match source files that merely mention the word in their
# name -- frontend/src/lib/reset-tokens.ts is real, imported application code, not a secret,
# and was silently never committed to git until this was caught. Un-ignore source code
# explicitly rather than narrowing the patterns, so a new *.ts/*.tsx file is never silently
# dropped the same way again.
!frontend/src/**/*.ts
!frontend/src/**/*.tsx
*.credentials
credentials.db
access_tokens.db
service_account*.json
gcp-key*.json

# Database Dumps and Production Backups
*.dump
*.sql
*.psql
*.dump.*
*.bak
*.backup
backup/
/backup/
var_backups/

# Logs and Runtime Artifacts
*.log
logs/
*.pid
*.sock

# Python Environment and Caches
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/
.pytest_cache/
.coverage

# Temporary and Scratch Files
*.tmp
*.temp
scratch/
test_output.docx
.system_generated/

# Office Temporary Lock Files
~$*.docx
~$*.xlsx
~$*.pptx

# Mail Spool & Scratch Files
reports/mail_spool/
scripts/scratch_*.py
.claude/

# OS Metadata
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
