# Template only — real secrets live in frontend/.env.production on the VM (gitignored).
# Copy this file, fill in the real values, and place it at
# /var/www/ist-health-frontend/.env.production on the server.

NODE_ENV=production
PORT=3000
GNUHEALTH_HOST=http://127.0.0.1:8000
GNUHEALTH_DATABASE=gnuhealth
GNUHEALTH_COMPANY_ID=2
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_ENCRYPTION_KEY=REPLACE_ME_32_BYTE_HEX_MINIMUM
SESSION_REVOCATION_DIR=.tokens
NEXT_PUBLIC_DEPLOYMENT_MODE=production
# Enables subdomain-per-tenant routing (middleware.ts) once the production domain is live,
# e.g. APP_BASE_DOMAIN=isthealth.com so central.isthealth.com resolves to the "qatar-outpatient"
# tenant. Leave unset until then -- falls back to manual tenant selection on /login.
APP_BASE_DOMAIN=
