# Template only — real secrets live in /var/www/ist-health-frontend-staging/.env.production
# on the VM (gitignored). Note: staging uses its own SESSION_ENCRYPTION_KEY, distinct from
# production's, generated separately.

NODE_ENV=production
PORT=3100
GNUHEALTH_HOST=http://127.0.0.1:8100
GNUHEALTH_DATABASE=gnuhealth_staging
GNUHEALTH_COMPANY_ID=2
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_ENCRYPTION_KEY=REPLACE_ME_32_BYTE_HEX_MINIMUM
SESSION_REVOCATION_DIR=.tokens
NEXT_PUBLIC_DEPLOYMENT_MODE=staging
