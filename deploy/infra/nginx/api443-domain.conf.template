server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @HOST@;

    ssl_certificate /etc/letsencrypt/live/@HOST@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@HOST@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 50M;
    server_tokens off;
    limit_conn conn_zone 40;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Tryton JSON-RPC only. The ONLY databases reachable from outside are the main one and
    # hospital databases named gnuhealth_h_<code>; test, staging and template databases are not
    # routable even though they live in the same PostgreSQL cluster. This pattern (not a backend
    # allow-list) is what makes a new hospital live without restarting the backend.
    location ~ "^/(gnuhealth|gnuhealth_h_[a-z0-9]{2,24})/" {   # quoted: nginx treats bare {} as a block
        limit_req zone=rpc_zone burst=60 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Hospital provisioning (Platform screen -> ist-provisioner on 127.0.0.1:8200). Bearer-token
    # protected inside the service; nginx adds TLS, a tiny body limit and a strict rate limit.
    location = /_provision {
        limit_req zone=login_zone burst=2 nodelay;
        client_max_body_size 1k;
        proxy_pass http://127.0.0.1:8200/provision;
        proxy_set_header Host $host;
        proxy_read_timeout 130s;
    }

    location / { return 404; }
}
