[Unit]
Description=GNU Health / Tryton Application Server (STAGING)
After=syslog.target network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=gnuhealth
Group=gnuhealth
WorkingDirectory=/home/gnuhealth
Environment=TRYTOND_CONFIG=/home/gnuhealth/trytond_staging.conf
Environment=TRYTOND_DATABASE_NAMES=gnuhealth_staging
ExecStart=/home/gnuhealth/venv/bin/gunicorn --workers 2 --timeout 300 --graceful-timeout 30 --bind 127.0.0.1:8100 trytond.application:app
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/gnuhealth /var/log

[Install]
WantedBy=multi-user.target
