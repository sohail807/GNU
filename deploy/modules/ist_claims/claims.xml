<?xml version="1.0"?>
<tryton>
    <data>
        <!-- Access: every staff member can read; front desk, billing and administration can work with the records. -->
        <record model="ir.model.access" id="access_authorization_default">
            <field name="model" search="[('model', '=', 'ist.claims.authorization')]"/>
            <field name="perm_read" eval="True"/>
