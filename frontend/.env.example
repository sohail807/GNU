# Server-only configuration. Copy to .env.local for local development and
# configure production values in the deployment secret manager.
GNUHEALTH_HOST=https://<clinic-domain>
GNUHEALTH_DATABASE=<configured-tryton-database>
GNUHEALTH_COMPANY_ID=<configured-company-id>

# Generate a unique random value of at least 32 bytes per deployment.
# Never commit the real value. Keep it stable across replicas during rollout.
SESSION_ENCRYPTION_KEY=<generate-a-unique-32-byte-or-longer-secret>

# Optional writable persistent location for session revocation records.
SESSION_REVOCATION_DIR=<private-writable-runtime-directory>

# Configure a real SMTP transport before enabling self-service password recovery.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
